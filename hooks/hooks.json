{
  "description": "Core agentic coding workflow hooks - security, verification, and notifications",
  "hooks": {
    "SessionStart": [
      {
        "description": "Reports checkout and project-check readiness without running checks",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-events.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "description": "Runs only an explicitly configured advisory quick_check",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-events.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "description": "Prevents execution of potentially dangerous commands",
        "matcher": "Bash|Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/dangerous_command_blocker.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "description": "Logs API failures (rate limits, auth errors) and sends toast notifications for visibility",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/stop-failure-logger.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "description": "Validates task graphs and project checks; notification means the response finished",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/validate-output.py\"",
            "timeout": 5,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/lint-on-stop.sh\"",
            "timeout": 600,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/workflow-events.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
